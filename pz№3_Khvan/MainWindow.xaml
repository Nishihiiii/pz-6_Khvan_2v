<Window x:Class="pz_3_Khvan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pz_3_Khvan"
        mc:Ignorable="d"
        Title="Практическая работа 6" Height="450" Width="800" Icon="/Resources/barvinok.ico">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="3*"/>
			<ColumnDefinition Width="197*"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="60"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>


		<Grid Grid.Row="0" Background="#CCCCFF" Grid.ColumnSpan="2">
			<Image Width="45" Height="45" HorizontalAlignment="Left" Margin="10,8,0,8" Source="/Resources/barvinok.png"/>
			<Button x:Name="btnBack" HorizontalAlignment="Left" Content="Назад" Click="btnBack_Click" Margin="657,10,0,10" Width="120"/>
		</Grid>

		<Frame x:Name="FrmMain" Grid.Row="1" NavigationUIVisibility="Hidden" ContentRendered="FrmMain_ContentRendered" Grid.ColumnSpan="2"/>

	</Grid>
</Window>
